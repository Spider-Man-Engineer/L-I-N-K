#!/usr/bin/env python3
import sys
import os

G = "\033[1;32m"
D = "\033[2;32m"
B = "\033[1m"
R = "\033[0m"
DIM = "\033[2m"
BRIGHT = "\033[92m"
RED = "\033[1;31m"

DIR = os.path.dirname(os.path.realpath(__file__))

usage = f"""
{G}      ██╗     ██╗███╗   ██╗██╗  ██╗{R}
{G}      ██║     ██║████╗  ██║██║ ██╔╝{R}
{G}      ██║     ██║██╔██╗ ██║█████╔╝ {R}
{G}      ██║     ██║██║╚██╗██║██╔═██╗ {R}
{G}      ███████╗██║██║ ╚████║██║  ██╗{R}
{G}      ╚══════╝╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝{R}
{D}      Live Instant Network Kommunication{R}

{B}Usage:{R} lnk <command> [options]

{B}Commands:{R}
  {BRIGHT}server{R}              Start the link server
  {BRIGHT}start{R}               Start a chat client (interactive menu)
  {BRIGHT}join{R} {D}<CODE>{R}         Join a room directly by invite code
  {BRIGHT}create{R}              Create a new room and join it
  {BRIGHT}help{R}                Show this help message

{B}Examples:{R}
  {D}lnk server{R}          Start the server
  {D}lnk start{R}           Open the interactive menu
  {D}lnk create{R}          Create a room and get an invite code
  {D}lnk join ABC123{R}     Join room with code ABC123
"""

if len(sys.argv) < 2:
    print(usage)
    sys.exit(1)

cmd = sys.argv[1]

if cmd == "server":
    os.execvp(sys.executable, [sys.executable, os.path.join(DIR, "server.py")])

elif cmd == "start":
    os.execvp(sys.executable, [sys.executable, os.path.join(DIR, "client.py")])

elif cmd == "join":
    if len(sys.argv) < 3:
        print(f"  {B}Usage:{R} lnk join <CODE>")
        sys.exit(1)
    code = sys.argv[2].upper()
    os.environ["LINK_JOIN_CODE"] = code
    os.execvp(sys.executable, [sys.executable, os.path.join(DIR, "client.py")])

elif cmd == "create":
    os.environ["LINK_CREATE"] = "1"
    os.execvp(sys.executable, [sys.executable, os.path.join(DIR, "client.py")])

elif cmd in ("help", "--help", "-h"):
    print(usage)

else:
    print(f"  {RED}× Unknown command: {cmd}{R}\n")
    print(usage)
    sys.exit(1)
